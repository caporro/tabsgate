{
  "openapi": "3.1.0",
  "info": {
    "title": "Tabs Gate",
    "version": "0.1.0",
    "description": "Accountless virtual-key gateway. Management requires the original provider credential AND keyword. Usage endpoints require a virtual key. No browser cookies or login sessions."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development; use HTTPS for remote clients."
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Process liveness",
        "operationId": "get_healthz",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Error; see README for codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Database and accounting readiness",
        "operationId": "get_readyz",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Error; see README for codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },

    "/api/v1/connections/{id}/keys": {
      "get": {
        "summary": "List virtual keys including revoked keys",
        "operationId": "get_api_v1_connections_id_keys",
        "security": [
          {
            "ProviderKey": [],
            "ManagementKeyword": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/VirtualKey"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error; see README for codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "summary": "Issue a virtual key",
        "operationId": "post_api_v1_connections_id_keys",
        "security": [
          {
            "ProviderKey": [],
            "ManagementKeyword": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedKey"
                }
              }
            }
          },
          "default": {
            "description": "Error; see README for codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateKey"
              }
            }
          }
        }
      }
    },
    "/api/v1/connections/{id}/keys/{keyId}": {
      "patch": {
        "summary": "Change limits without resetting usage",
        "operationId": "patch_api_v1_connections_id_keys_keyId",
        "security": [
          {
            "ProviderKey": [],
            "ManagementKeyword": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VirtualKey"
                }
              }
            }
          },
          "default": {
            "description": "Error; see README for codes.",
            "content": {
